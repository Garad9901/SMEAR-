# ── RouteIQ X — Local Development Env Configuration ────────────────
ENVIRONMENT=development
VERSION=2.4.0

# ── Database ────────────────────────────────────────────────────────
# Inside Docker containers, 'postgres' refers to the DB service
DATABASE_URL=postgresql://routeiq:routeiq_secret@postgres:5432/routeiq_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Kafka ───────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP=routeiq-api-group

# ── Auth & Cryptography ─────────────────────────────────────────────
SECRET_KEY=dev-session-key-routeiq-must-be-secure-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Third Party API Integration keys (Placeholder/Demo values) ────
OPENWEATHER_API_KEY=dummy_weather_api_key_for_caching
GOOGLE_MAPS_API_KEY=dummy_maps_api_key
TOMTOM_API_KEY=dummy_tomtom_api_key
SENTINEL_HUB_CLIENT_ID=dummy_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=dummy_sentinel_secret
PINECONE_API_KEY=dummy_pinecone_key
PINECONE_ENVIRONMENT=us-east-1-aws

# ── OpenTelemetry & Observability ──────────────────────────────────
OTEL_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=routeiq-api-gateway

# ── Storage ─────────────────────────────────────────────────────────
S3_BUCKET=routeiq-x-artifacts
AWS_REGION=ap-south-1
